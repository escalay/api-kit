{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "$comment": "The browser modules are checked by tsconfig.web.json",
  "exclude": [
    "src/browser",
    "test/shadcn",
    "test/.generated",
    "test/workers"
  ]
}
