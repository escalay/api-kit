// __title__ on Cloudflare Workers. Secrets (API_KEYS, OAUTH_SIGNING_KEY) go in with `wrangler secret put`, locally in
// .dev.vars (git-ignored; copy .dev.vars.example). No account_id and no database id here, so anyone can deploy it:
// the Deploy to Cloudflare button makes the database in the deployer's account, and `pnpm run deploy:env` fills yours
// from CLOUDFLARE_ACCOUNT_ID and D1_DB_ID. `npx @escalay/kit button --check` keeps it that way.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__name__",
  "main": "src/worker.ts",
  "compatibility_date": "__date__",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The browser app (web/): what is built under /app/ is served as files, any other /app/ path gets index.html, and // preset:app
  // the Worker answers everything else // preset:app
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/*", "!/app/*"] }, // preset:app
  "d1_databases": [
    // migrations/ is written by `pnpm migrations` from every feature's steps and applied at deploy
    { "binding": "DB", "database_name": "__name__", "migrations_dir": "migrations" }
  ]
}
