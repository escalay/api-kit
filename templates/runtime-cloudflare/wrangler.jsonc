// __title__ on Cloudflare Workers. Secrets (API_KEYS, OAUTH_SIGNING_KEY) go in with `wrangler secret put`, locally in
// .dev.vars (git-ignored; copy .dev.vars.example). Before the first deploy: pin account_id (wrangler's login may be
// another account), `wrangler d1 create __name__` and put its id below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__name__",
  "main": "src/worker.ts",
  // "account_id": "<the Cloudflare account this deploys to>",
  "compatibility_date": "__date__",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The browser app (web/): what is built under /app/ is served as files, any other /app/ path gets index.html, and // preset:app
  // the Worker answers everything else // preset:app
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/*", "!/app/*"] }, // preset:app
  "d1_databases": [
    // migrations/ is written by `pnpm migrations` from every feature's steps and applied at deploy
    { "binding": "DB", "database_name": "__name__", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
