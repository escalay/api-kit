# Local settings for `pnpm dev`, which reads .env (git-ignored): `npx @escalay/kit env --write` makes it from this file,
# a value for each. API_KEYS holds name:sha256 hashes, never keys.
API_KEYS=""
# OAUTH_SIGNING_KEY: the OAuth server's ES256 key, a secret: `npx @escalay/kit env --write` makes one (or `generateOAuthKey()` from ./kit/index.js); without it OAuth is off
OAUTH_SIGNING_KEY=""
