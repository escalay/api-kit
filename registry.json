  "items": [
    {
      "name": "core",
      "type": "registry:item",
      "title": "Core",
      "description": "createAgentApi: OpenAPI 3.1 + Scalar docs, HAL links, problem+json, API keys + Access, ETags and Cache-Control, Idempotency-Key and rate limits, discovery (api-catalog, Link headers, robots.txt, Markdown for agents), a key-value store type; an OAuth server plugs in from the `oauth` part",
      "dependencies": [
        "hono@^4.13.14",
        "@hono/zod-openapi@^1.6.3",
        "zod@^4.6.7",
        "jose@^6.2.14",
        "@scalar/hono-api-reference@^0.12.17"
      ],
      "files": [
        {
          "path": "src/core/api.ts",
          "type": "registry:file",
          "target": "~/src/kit/core/api.ts"
        },
        {
          "path": "src/core/auth.ts",
          "type": "registry:file",
          "target": "~/src/kit/core/auth.ts"
        },
