{
  "name": "@escalay/kit",
  "version": "1.14.1",
  "type": "module",
  "description": "Agent-ready HTTP APIs as parts an app copies in (shadcn-style): Hono + zod OpenAPI 3.1, HAL links, problem+json, cursors, ETags, API keys, discovery, a generated agent guide with skills, an MCP server over the same routes, vector search by words, picture and likeness, and its headless browser side.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escalay/api-kit.git"
  },
  "homepage": "https://github.com/escalay/api-kit#readme",
  "bugs": "https://github.com/escalay/api-kit/issues",
  "files": [
    "cli.mjs",
    "registry.json",
    "src",
    "templates",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p test/workers/tsconfig.json",
    "test": "vitest run",
    "test:starter": "node scripts/starter-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "kit": "node cli.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "@simplewebauthn/server": "14.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "wrangler": "4.158.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "bin": {
    "kit": "./cli.mjs"
  }
}
